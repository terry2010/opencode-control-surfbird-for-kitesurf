{
  "name": "opencode-control-surfbird-for-kitesurf",
  "version": "0.1.0",
  "description": "OpenCode plugin: AI agent controls a Kitesurf/surfbird browser engine over CDP — 28 surfbird_* tools with per-session isolation, semantic snapshots, screenshots/PDF. Shares the host-independent src/cdp core with the DSH plugin.",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "kitesurf",
    "surfbird",
    "browser",
    "cdp",
    "automation",
    "ai-agent",
    "browser-automation",
    "agent-tools",
    "web-automation"
  ],
  "license": "Apache-2.0",
  "author": {
    "name": "terry2010",
    "url": "https://github.com/terry2010"
  },
  "type": "module",
  "exports": {
    ".": "./lib/index.js",
    "./tui": "./lib/tui.js",
    "./gui-experimental": "./dist/gui-experimental.cjs",
    "./package.json": "./package.json"
  },
  "main": "lib/index.js",
  "bin": {
    "surfbird-token": "./lib/tokenfile-cli.js"
  },
  "files": [
    "src",
    "lib",
    "dist",
    "skills",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.gui.json --noEmit && vite build",
    "prepack": "npm run build",
    "test": "node --test test/unit/*.test.mjs",
    "test:live": "node --test test/live/*.test.mjs",
    "check": "node --input-type=module -e \"import('./src/index.ts').then(m => { const p = m.default; if (!p || typeof p.setup !== 'function' || !p.id) throw new Error('plugin shape invalid'); console.log('OK', p.id) })\""
  },
  "peerDependencies": {
    "@opencode/plugin": "*",
    "@opentui/core": ">=0.6.6",
    "@opentui/solid": ">=0.6.6",
    "solid-js": ">=1.9.0"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "turndown": "^7.2.5",
    "ws": "~8.22.2",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@opencode/plugin": "^2.2.5",
    "@opentui/core": "^0.9.0",
    "@opentui/solid": "^0.9.0",
    "@types/node": "^26.6.6",
    "effect": "^4.0.6",
    "jsonc-parser": "^3.3.1",
    "solid-js": "^1.9.18",
    "typescript": "^5.9.0",
    "vite": "^8.3.5",
    "vite-plugin-solid": "^2.11.15"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
